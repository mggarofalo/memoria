# memoria-qmd configuration. Every value is read from the environment; this
# file documents the knobs. Nothing loads it automatically — export the values
# in your shell, or set them in deploy/compose.yaml.

# Interface and port. Loopback is the safe default. The container image binds
# 0.0.0.0 inside its bridge network, where only Memoria.Api can reach it. Never
# bind 0.0.0.0 on a machine with a public interface.
MEMORIA_QMD_HOST=127.0.0.1
MEMORIA_QMD_PORT=8282

# Shared secret presented by Memoria.Api as `Authorization: Bearer <secret>`.
# Required when MEMORIA_QMD_HOST is not loopback; minimum 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEMORIA_QMD_SECRET=
# With none set, each run makes its own and nothing else can call it. Placeholders and
# repeated characters are refused. A worker token follows the same rules.
# Or read it at startup from a file holding one line. Setting both is an error.
# On POSIX the file must not be readable by group or others (chmod 600).
#MEMORIA_QMD_SECRET_FILE=/path/to/secret

# QMD index. Defaults to ~/.cache/qmd/index.sqlite (or $XDG_CACHE_HOME/qmd).
# The index must already exist; the sidecar never creates one.
#MEMORIA_QMD_DB_PATH=C:\Users\you\.cache\qmd\index.sqlite

# Keep the three GGUF models resident instead of unloading after 5 idle
# minutes (SDK default). Costs ~4 GB VRAM, saves ~11 s on the first query
# after a lull.
MEMORIA_QMD_KEEP_WARM=1

# Run one reranked query at startup so the first real request is warm.
MEMORIA_QMD_WARMUP=1

# pino level: trace, debug, info, warn, error.
MEMORIA_QMD_LOG_LEVEL=info

# Search tuning. Filters are applied after retrieval, so a filtered search
# fetches limit*OVERFETCH candidates (capped at MAX_FETCH) before filtering.
#MEMORIA_QMD_SEARCH_MAX_LIMIT=100
#MEMORIA_QMD_FILTER_OVERFETCH=4
#MEMORIA_QMD_FILTER_MAX_FETCH=200

# Request body cap in bytes (POST /documents carries whole transcripts).
#MEMORIA_QMD_BODY_LIMIT_BYTES=16777216

# Reindex scheduling. A document write waits for this much quiet before its
# index update runs, so a burst costs one scan; MAX_WAIT bounds the wait from
# the first write. A debounce of 0 turns it off. POST /reindex never waits.
#MEMORIA_QMD_REINDEX_DEBOUNCE_MS=60000
#MEMORIA_QMD_REINDEX_MAX_WAIT_MS=300000

# The job queue's database. Defaults to index.sqlite.queue.sqlite beside the index.
#MEMORIA_QMD_QUEUE_DB_PATH=

# How long shutdown waits for queued jobs. Keep it under compose's
# stop_grace_period (15 s).
#MEMORIA_QMD_SHUTDOWN_DRAIN_MS=10000

# Where model work runs. "local" is in this process. "remote" sends it to a
# memoria-worker; see docs/workers.md, which also lists what has not been verified.
#MEMORIA_QMD_LLM=local
#MEMORIA_QMD_WORKER_URL=http://192.168.1.20:8383
#MEMORIA_QMD_WORKER_TOKEN=
#MEMORIA_QMD_WORKER_TOKEN_FILE=/path/to/token
# Or a pool, as a JSON list that names each token's environment variable:
#MEMORIA_QMD_WORKERS=[{"name":"desktop","url":"http://192.168.1.20:8383","tokenEnv":"DESKTOP_WORKER_TOKEN","priority":1}]
#MEMORIA_QMD_WORKER_POLL_MS=10000
#MEMORIA_QMD_EMBED_BATCH_BYTES=262144
# Deadline for one search-time rerank call.
#MEMORIA_QMD_RERANK_TIMEOUT_MS=20000
# Deadline for all of one search's calls to workers. Keep it well under Memoria.Api's client timeout.
#MEMORIA_QMD_SEARCH_DEADLINE_MS=60000
# Tokenize and embed queries on this host's CPU when no worker answers, if QMD has the model cached here.
#MEMORIA_QMD_LLM_FALLBACK=1
# Every embedding must have this length. 0 pins it to the first response.
#MEMORIA_QMD_EMBED_DIMENSIONS=768

# --- Network and limits ---------------------------------------------------------
# Between hosts, this service runs on a WireGuard tunnel: plain http, with the tunnel
# doing the encrypting. Set this to bind a tunnel address or reach a worker on one.
# Otherwise the start fails. See docs/deployment.md.
#MEMORIA_QMD_ALLOW_HTTP_ON_PRIVATE_NETWORK=1
# DNS names a request may arrive under, besides localhost. An IP address always works.
#MEMORIA_QMD_ALLOWED_HOSTS=memoria.lan,host.docker.internal
# Largest document POST /documents takes. Larger gets a 413.
#MEMORIA_QMD_MAX_DOCUMENT_BYTES=2097152
#MEMORIA_QMD_HEADERS_TIMEOUT_MS=10000
#MEMORIA_QMD_REQUEST_TIMEOUT_MS=300000
#MEMORIA_QMD_MAX_CONNECTIONS=1024
# Connections one address may hold, and Memoria.Api's address, which gets more.
#MEMORIA_QMD_MAX_CONNECTIONS_PER_SOURCE=64
#MEMORIA_QMD_API_ADDRESSES=10.0.0.1
#MEMORIA_QMD_MAX_CONNECTIONS_PER_API_ADDRESS=512
# Searches running at once, waiting, and for how long. Past those, a 503 with Retry-After.
#MEMORIA_QMD_SEARCH_CONCURRENCY=4
#MEMORIA_QMD_SEARCH_QUEUE=16
#MEMORIA_QMD_SEARCH_MAX_WAIT_MS=10000
