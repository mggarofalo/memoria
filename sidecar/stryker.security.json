{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": ["sidecar/test/**/*.test.ts"],
    "nodeArgs": ["--max-old-space-size=512", "--test-reporter=tap", "-r", "{{hookFile}}", "{{testFile}}"]
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "mutate": ["sidecar/src/auth.ts", "sidecar/src/llm/validate.ts"],
  "ignorePatterns": ["/cli", "/src", "/tests/Memoria.Api.Tests", "/docs", "/deploy", "/.claude", "/sidecar/test/install-scripts.test.ts", "/sidecar/test/docs-match-code.test.ts", "/sidecar/test/mutation-runner.test.ts", "**/bin", "**/obj"],
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "sidecar/reports/mutation-security/mutation.html" },
  "jsonReporter": { "fileName": "sidecar/reports/mutation-security/mutation.json" },
  "thresholds": { "high": 100, "low": 96, "break": 96 }
}
