{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": ["test/**/*.test.ts"],
    "nodeArgs": ["--test-reporter=tap", "-r", "{{hookFile}}", "{{testFile}}"]
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/auth.ts"],
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation-security/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation-security/mutation.json" },
  "thresholds": { "high": 95, "low": 90, "break": null }
}
