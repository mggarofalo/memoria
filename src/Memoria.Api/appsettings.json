{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Memoria": {
    "Sidecar": {
      "BaseUrl": "http://127.0.0.1:8282",
      "Secret": null,
      "Timeout": "00:02:00",
      "ReadinessTimeout": "00:00:05"
    },
    "Search": {
      "DefaultLimit": 10,
      "MaxLimit": 100,
      "RerankByDefault": true,
      "DefaultCollections": null,
      "MaxMultiGetBytes": 16777216
    },
    "Mcp": {
      "Enabled": true,
      "Path": "/mcp"
    },
    "Ingest": {
      "MaxDocumentBytes": 2097152,
      "MaxSessionBytes": 268435456,
      "MaxConcurrentLargeUploads": 2,
      "MaxConcurrentLargeDocuments": 8,
      "MaxConcurrentRenders": 2,
      "MinUploadBytesPerSecond": 16384,
      "SessionUploadDeadline": "01:00:00",
      "DocumentUploadDeadline": "00:05:00",
      "DeleteWriteWait": "00:00:30",
      "MinReindexInterval": "00:00:10"
    },
    "Auth": {
      "Mode": "ApiKey",
      "DatabasePath": null,
      "RateLimit": {
        "Enabled": true,
        "PermitLimit": 120,
        "Window": "00:01:00"
      },
      "Audit": {
        "IncludeQueries": false,
        "RetentionDays": 90,
        "MaxRowsPerKey": 100000
      },
      "FailedAuth": {
        "Enabled": true,
        "PermitLimit": 20,
        "Window": "00:01:00",
        "MaxTrackedAddresses": 10000
      },
      "TrustedProxies": []
    }
  }
}
