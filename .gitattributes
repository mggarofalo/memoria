# Line endings are enforced here and mirrored in .editorconfig.
# C# tooling (VS, dotnet format) assumes CRLF; everything else is LF.

# .NET
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.razor   text eol=crlf
*.cshtml  text eol=crlf

# Go — gofmt emits LF; CRLF breaks `gofmt -l` and golangci-lint.
*.go      text eol=lf
go.mod    text eol=lf
go.sum    text eol=lf

# Everything else
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
Dockerfile text eol=lf

# Binary
*.gguf    binary
*.sqlite  binary
*.png     binary
