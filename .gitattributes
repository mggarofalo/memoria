# Line endings are enforced here and mirrored in .editorconfig.
# C# tooling (VS, dotnet format) assumes CRLF; everything else is LF.

# .NET
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.razor   text eol=crlf
*.cshtml  text eol=crlf

# Go — gofmt emits LF; CRLF breaks `gofmt -l` and golangci-lint.
*.go      text eol=lf
go.mod    text eol=lf
go.sum    text eol=lf

# Node sidecar (sidecar/) — LF like everything non-.NET.
*.ts      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.ps1     text eol=lf
*.psm1    text eol=lf

# Everything else
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.jsonl text eol=lf
*.txt   text eol=lf
Dockerfile text eol=lf

# Binary
*.gguf    binary
*.sqlite  binary
*.png     binary

# Vendored gitleaks files stay byte for byte as published.
src/Memoria.Core/Redaction/Gitleaks/LICENSE text eol=lf
