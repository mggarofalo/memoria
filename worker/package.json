{
  "name": "memoria-worker",
  "version": "0.0.0",
  "description": "Inference worker for Memoria: supervises llama-server instances for QMD's three models and serves them over a small authenticated HTTP API.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "smoke": "node scripts/smoke.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "node ../node_modules/c8/bin/c8.js node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
