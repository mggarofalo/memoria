# Copy to .env beside compose.yaml and fill in. Every value is optional.

# A fine-grained token on this one repository with "Commit statuses: read and write" and nothing else. The
# repository is public, so the clone needs no token. Leave it empty to write each status to the log instead.
GITHUB_TOKEN=

# Caps on the whole run: CPUs as a decimal, memory as Docker writes it (10g, 8192m).
MUTATION_CPUS=6
MUTATION_MEMORY=10g

# Stryker.NET's test runners. Empty: its default, half the CPUs above. Each holds a copy of the test suite.
MUTATION_CONCURRENCY=

# How often to look for new commits, in seconds.
POLL_SECONDS=900

# changed: mutate the files changed since the last mutated commit, in the packages they belong to (minutes).
# package: mutate every file of those packages (hours for the sidecar or .NET).
MUTATION_SCOPE=changed

# Where the clone, the state and the reports live: the compose volume "state", or a host path such as
# /srv/memoria-mutation.
MUTATION_STATE=state

REPO_URL=https://github.com/mggarofalo/memoria.git
BRANCH=main
